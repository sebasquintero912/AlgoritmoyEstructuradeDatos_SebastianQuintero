import re
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


def normalizar_tiempo_a_segundos(tiempo_str):
    if pd.isna(tiempo_str):
        return np.nan
    tiempo_str = str(tiempo_str).strip()
    match = re.match(r'(\d+)m\s*(\d+)s', tiempo_str)
    if match:
        return (int(match.group(1)) * 60) + int(match.group(2))
    return 5400


data_ejemplo = {
    'Torneo': ['Copa América', 'Eurocopa', 'Copa América', 'Eurocopa', 'Copa América', 'Eurocopa', 'Copa América', 'Eurocopa'],
    'Equipo_Local': ['Argentina', 'Alemania', 'Brasil', 'España', 'Uruguay', 'Francia', 'Colombia', 'Italia'],
    'Equipo_Visitante': ['Canadá', 'Escocia', 'Colombia', 'Italia', 'Bolivia', 'Países Bajos', 'Paraguay', 'Bélgica'],
    'Goles_Local': [2, 5, 0, 1, 3, 0, 2, 0],
    'Goles_Visitante': [0, 1, 0, 0, 1, 0, 1, 1],
    'Tiros_Local': [18, 19, 10, 15, 12, 8, 14, 7],
    'Tiros_Visitante': [5, 8, 12, 6, 7, 10, 5, 13],
    'Posesion_Local': ['65%', '73%', '50%', '55%', '60%', '45%', '52%', '40%'],
    'Fecha_Partido': ['2024-06-20', '2024-06-14', '2024-07-06', '2024-07-09', '2024-06-23', '2024-06-21', '2024-06-24', '2024-06-15'],
    'Tiempo_de_Juego': ['90m 0s', '90m 0s', '120m 0s', '90m 0s', '90m 0s', '90m 0s', '90m 0s', '90m 0s'],
    'posesion_visitante': ['35%', '27%', '50%', '45%', '40%', '55%', '48%', '60%'],
    'posesion_total': ['100%', '100%', '100%', '100%', '100%', '100%', '100%', '100%' ]
}
df = pd.DataFrame(data_ejemplo)

columnas_numericas = ['Goles_Local', 'Goles_Visitante',
                      'Tiros_Local', 'Tiros_Visitante']
for col in columnas_numericas:
    df[col] = pd.to_numeric(df[col], errors='coerce')
df['Posesion_Local'] = df['Posesion_Local'].str.replace('%', '', regex=False)
df['Posesion_Local'] = pd.to_numeric(df['Posesion_Local'], errors='coerce')
df['Posesion_Visitante'] = 100 - df['Posesion_Local']
df['Segundos_Totales'] = df['Tiempo_de_Juego'].apply(
    normalizar_tiempo_a_segundos)
df.dropna(subset=columnas_numericas +
          ['Segundos_Totales', 'Posesion_Local'], inplace=True)

df_local = df.rename(columns={'Equipo_Local': 'Equipo', 'Goles_Local': 'Goles_Anotados', 'Goles_Visitante': 'Goles_Recibidos', 'Tiros_Local': 'Tiros_Anotados',
                     'Tiros_Visitante': 'Tiros_Recibidos', 'Posesion_Local': 'Posesion_Propia', 'Posesion_Visitante': 'Posesion_Rival'}).assign(Condicion='Local')
df_visitante = df.rename(columns={'Equipo_Visitante': 'Equipo', 'Goles_Visitante': 'Goles_Anotados', 'Goles_Local': 'Goles_Recibidos', 'Tiros_Visitante': 'Tiros_Anotados',
                         'Tiros_Local': 'Tiros_Recibidos', 'Posesion_Visitante': 'Posesion_Propia', 'Posesion_Local': 'Posesion_Rival'}).assign(Condicion='Visitante')

columnas_finales = ['Torneo', 'Equipo', 'Goles_Anotados',
                    'Goles_Recibidos', 'Tiros_Anotados', 'Tiros_Recibidos', 'Posesion_Propia']
df_normalizado = pd.concat(
    [df_local[columnas_finales], df_visitante[columnas_finales]], ignore_index=True)

df_normalizado['Puntos_Partido'] = df_normalizado['Goles_Anotados'] * 1
df_normalizado['Resultado_Clasico'] = np.where(
    df_normalizado['Goles_Anotados'] > df_normalizado['Goles_Recibidos'], 1, 0)

# 🎯 Análisis y Gráficos
analisis_equipo = df_normalizado.groupby(['Torneo', 'Equipo']).agg(
    Partidos_Jugados=('Equipo', 'count'),
    Goles_Anotados=('Goles_Anotados', 'sum'),
    Tiros_Totales=('Tiros_Anotados', 'sum'),
    Puntos_Totales=('Puntos_Partido', 'sum'),
    Victorias=('Resultado_Clasico', 'sum')
).reset_index()

analisis_equipo['PPM'] = analisis_equipo['Puntos_Totales'] / \
    analisis_equipo['Partidos_Jugados']
analisis_equipo['Eficacia_Tiro (%)'] = (
    analisis_equipo['Goles_Anotados'] / analisis_equipo['Tiros_Totales']) * 100
analisis_equipo['%_Victorias'] = (
    analisis_equipo['Victorias'] / analisis_equipo['Partidos_Jugados']) * 100
analisis_equipo = analisis_equipo.round(2)
analisis_equipo = analisis_equipo.sort_values(by='PPM', ascending=False)

print("\n--- 1. Tabla de Estadísticas de Equipos ---")
print(analisis_equipo.to_string(index=False))


plt.style.use('seaborn-v0_8-darkgrid')
fig, axes = plt.subplots(1, 3, figsize=(32, 8))
plt.subplots_adjust(wspace=0.4)

# --- Gráfico 1 (Izquierda): Puntos por Partido (PPM_Goles) - Barplot Vertical ---
df_sorted_ppm = analisis_equipo.sort_values(by='PPM', ascending=False)
sns.barplot(
    data=df_sorted_ppm,
    x='Equipo',
    y='PPM',
    hue='Torneo',
    dodge=False,
    palette={'Copa América': '#3D9970', 'Eurocopa': '#FF4136'},
    ax=axes[0]
)
axes[0].set_title(
    'Puntos por Gol Anotado por Partido (PPM_Goles) ', fontsize=12)
axes[0].set_ylabel('Puntos por Gol Anotado / Partido', fontsize=10)
axes[0].set_xticklabels(labels=df_sorted_ppm['Equipo'],
                        rotation=45, ha='right', fontsize=9)
axes[0].grid(axis='y', linestyle='--', alpha=0.7)
# Leyenda para el Gráfico 1
axes[0].legend(title='Torneo', loc='upper center', bbox_to_anchor=(0.5, 1.15), ncol=2,
               frameon=True, borderaxespad=0., fontsize=10)


# --- Gráfico 2 (Centro): Distribución Total de Goles por Torneo - Pie Chart ---
goles_por_torneo = df_normalizado.groupby('Torneo')['Goles_Anotados'].sum()
labels = goles_por_torneo.index
sizes = goles_por_torneo.values
colors = [sns.color_palette("pastel")[0] if label == 'Copa América' else sns.color_palette(
    "pastel")[3] for label in labels]

axes[1].pie(sizes, labels=labels, autopct='%1.1f%%', startangle=90, colors=colors,
            wedgeprops={'edgecolor': 'black', 'linewidth': 0.8}, textprops={'fontsize': 10})
axes[1].set_title(
    'Distribución Total de Goles Anotados por Torneo ', fontsize=12)
axes[1].axis('equal')
axes[1].set_ylabel('')  

# --- Gráfico 3 (Derecha): Porcentaje de Victorias por Equipo - Barplot Horizontal Ordenado ---
df_sorted_win = analisis_equipo.sort_values(by='%_Victorias', ascending=True)
sns.barplot(
    data=df_sorted_win,
    x='%_Victorias',
    y='Equipo',
    color='#2C854E',  
    ax=axes[2]
)
axes[2].set_title('Ranking de % de Victorias por Partido ', fontsize=12)
axes[2].set_xlabel('% Victorias (Máx. 100%)', fontsize=10)
axes[2].set_ylabel('Equipo', fontsize=10)
axes[2].tick_params(axis='y', labelsize=10)
axes[2].grid(axis='x', linestyle='--', alpha=0.7)

plt.tight_layout(rect=[0, 0, 1, 1])
plt.show()

print(df[['Equipo_Visitante', 'Posesion_Visitante']].to_string(index=False))
